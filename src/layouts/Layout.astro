---
import "../styles/global.css";
import Navbar from "../components/navbar.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Cabañas de mar en Chapadmalal | Paradise",
  description = "Cabañas para 2, 4 y 6 personas en Chapadmalal. Jardín, parrilla y fogonero para disfrutar unos días entre el campo y el mar.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only fixed left-4 top-4 z-[60] rounded-lg bg-primary px-4 py-3 text-primary-foreground focus:not-sr-only"
    >
      Saltar al contenido
    </a>
    <Navbar />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
