---
import { Image } from "astro:assets";
import { ArrowDown, ArrowUpRight, MapPin } from "@lucide/astro";
import portada from "../images/casa-paradise/portada.png";
import ButtonLink from "./ui/ButtonLink.astro";
import { site } from "../lib/site";
---

<section class="relative isolate flex min-h-[640px] items-end overflow-hidden bg-primary text-white md:min-h-[min(780px,calc(100svh-80px))]">
  <Image
    src={portada}
    width={1920}
    alt="Casa Paradise rodeada de árboles y jardín en Chapadmalal"
    class="absolute inset-0 -z-20 size-full object-cover object-[center_58%]"
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/80 via-black/30 to-black/10"></div>
  <div class="page-container pb-10 pt-28 md:pb-14">
    <p class="mb-6 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-white/90">
      <MapPin size={15} aria-hidden="true" />
      Chapadmalal, Buenos Aires
    </p>
    <h1 class="max-w-3xl text-6xl font-medium leading-[1.02] tracking-[-0.05em] sm:text-7xl lg:text-8xl">
      Cabañas
      <br />
      de mar.
    </h1>
    <div class="mt-7 flex flex-col justify-between gap-8 md:flex-row md:items-end">
      <div class="max-w-lg">
        <p class="text-lg leading-relaxed text-white/90 md:text-xl">
          Unos días de descanso con familia y amigos, entre el campo y el mar.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <ButtonLink
            href="/cabanas"
            size="lg"
            class="bg-background text-foreground hover:bg-white"
          >
            Conocé las cabañas
            <ArrowUpRight size={17} aria-hidden="true" />
          </ButtonLink>
          <ButtonLink
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            variant="outline"
            size="lg"
            class="border-white/40 bg-black/20 text-white hover:bg-white/15 hover:text-white"
          >
            Hablemos por WhatsApp
          </ButtonLink>
        </div>
      </div>
      <a
        href="#cabanas"
        class="flex items-center gap-3 self-start text-sm text-white/90 md:self-end"
      >
        <span>Un lugar para bajar un cambio</span>
        <span class="flex size-10 items-center justify-center rounded-full border border-white/40">
          <ArrowDown size={17} aria-hidden="true" />
        </span>
      </a>
    </div>
  </div>
</section>
