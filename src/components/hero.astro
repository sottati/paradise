---
import { Image } from "astro:assets";
import portada from "../images/casa-paradise/portada.png";
---

<div class="relative w-full h-screen overflow-hidden">
  <Image
    src={portada}
    alt="Portada"
    class="absolute top-0 left-0 w-full h-full object-cover -z-10"
  />
  <div class="absolute top-0 left-0 w-full h-full bg-black/50 -z-9"></div>
  <div
    class="relative z-10 flex flex-col p-16 justify-end items-left h-full text-white animate-fade-in-bottom select-none"
  >
    <p class="text-8xl font-medium mb-4">
      Cabañas <br /> de Mar
    </p>
    <p class="text-4xl font-extralight max-w-2xl">
      El lugar perfecto para pasar vacaciones o simplemente disfrutar de unos
      días de descanso con familia y amigos, entre el campo y el mar
    </p>
  </div>
</div>
