---
import { Image } from "astro:assets";
import { ArrowUpRight, Camera } from "@lucide/astro";
import logo from "../assets/paradiseicon.png";
import ButtonLink from "./ui/ButtonLink.astro";
import { Separator } from "./ui/separator";
import { cabinLinks, site } from "../lib/site";
const currentYear = new Date().getFullYear();
---

<footer class="bg-primary text-primary-foreground">
  <div class="page-container pb-7 pt-14 md:pt-20">
    <div class="mb-12 flex flex-col justify-between gap-7 sm:flex-row sm:items-end">
      <div>
        <p class="mb-4 text-xs uppercase tracking-[0.18em] text-white/70">
          La próxima puede ser tu escapada
        </p>
        <h2 class="text-3xl font-medium tracking-tight md:text-4xl">
          Hacete un lugar para descansar.
        </h2>
      </div>
      <ButtonLink
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="self-start bg-background text-foreground hover:bg-white sm:shrink-0"
        size="lg"
      >
        Escribinos
        <ArrowUpRight size={17} aria-hidden="true" />
      </ButtonLink>
    </div>
    <Separator className="bg-white/20" />
    <div class="grid gap-10 py-10 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-3">
          <Image
            src={logo}
            alt=""
            width={44}
            height={44}
            class="size-11 rounded-full bg-background p-1"
          />
          <span>
            <span class="block text-xl font-medium tracking-tight">
              paradise
            </span>
            <span class="text-xs text-white/70">Chapadmalal · Desde 2019</span>
          </span>
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/70">
          Cabañas de mar. Un lugar para disfrutar con familia y amigos.
        </p>
      </div>
      <div>
        <h3 class="mb-4 text-sm font-medium">Las cabañas</h3>
        <ul class="space-y-3 text-sm text-white/75">
          {cabinLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mb-4 text-sm font-medium">Conocé Paradise</h3>
        <ul class="space-y-3 text-sm text-white/75">
          <li>
            <a href="/cabanas" class="hover:text-white">
              Todas las cabañas
            </a>
          </li>
          <li>
            <a href="/#experiencia" class="hover:text-white">
              La experiencia
            </a>
          </li>
          <li>
            <a href="/#ubicacion" class="hover:text-white">
              Ubicación
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="mb-4 text-sm font-medium">Seguimos en contacto</h3>
        <ul class="space-y-3 text-sm text-white/75">
          <li>
            <a
              href={site.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a
              href={site.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 hover:text-white"
            >
              <Camera size={15} aria-hidden="true" />
              Instagram
            </a>
          </li>
          <li>
            <a
              href={site.maps}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white"
            >
              Cómo llegar
            </a>
          </li>
        </ul>
      </div>
    </div>
    <Separator className="bg-white/20" />
    <div class="flex flex-col justify-between gap-3 pt-6 text-xs text-white/65 sm:flex-row">
      <p>
        © {currentYear} Paradise Chapadmalal. Todos los derechos reservados.
      </p>
      <p>Chapadmalal, Buenos Aires, Argentina</p>
    </div>
  </div>
</footer>
