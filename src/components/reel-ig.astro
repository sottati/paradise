---
interface Props {
  url: string;
}
const { url } = Astro.props;
---

<div class="min-w-0 overflow-hidden rounded-xl border bg-background p-2">
  <blockquote
    class="instagram-media"
    data-instgrm-permalink={url}
    data-instgrm-version="14"
  >
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="flex min-h-64 items-center justify-center p-6 text-sm underline underline-offset-4"
    >
      Ver este video en Instagram
    </a>
  </blockquote>
</div>
<script async src="https://www.instagram.com/embed.js"></script>
<style is:global>
  .instagram-media {
    min-width: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    margin: 0 !important;
    border: 0 !important;
    box-shadow: none !important;
  }
</style>
