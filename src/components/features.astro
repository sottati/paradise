---
import { Sparkles, Flame, ShieldCheck, Wifi, Tv } from "@lucide/astro";
import { Card, CardContent } from "./ui/card";
const features = [
  {
    title: "Detalles que acompañan",
    description:
      "Sábanas y un kit de cortesía con café, té, agua mineral y bombones para recibirte.",
    icon: Sparkles,
  },
  {
    title: "Parrilla y fogonero",
    description:
      "Un espacio compartido para cocinar y quedarse charlando alrededor del fuego.",
    icon: Flame,
  },
  {
    title: "Un entorno cuidado",
    description:
      "Predio cerrado con cerco natural, cámaras de seguridad e iluminación con sensores.",
    icon: ShieldCheck,
  },
  {
    title: "Wi-Fi para conectar",
    description:
      "Fibra óptica e internet satelital para trabajar o seguir en contacto desde la cabaña.",
    icon: Wifi,
  },
  {
    title: "También, una buena peli",
    description:
      "Smart TV con televisión satelital y acceso a tus aplicaciones de streaming.",
    icon: Tv,
  },
];
---

<section id="servicios" class="section-space border-y bg-secondary/40">
  <div class="page-container grid gap-10 lg:grid-cols-[0.8fr_1.5fr] lg:gap-20">
    <div>
      <p class="eyebrow mb-4">Sentite en casa</p>
      <h2 class="section-title">
        Lo necesario
        <br />
        para descansar.
      </h2>
      <p class="section-copy mt-5 max-w-sm">
        Venís a desconectar. Nosotros nos ocupamos de que estés cómodo.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {features.map((feature) => (
        <Card className="gap-0 border-border/70 py-0 shadow-none">
          <CardContent className="p-6">
            <feature.icon
              size={23}
              stroke-width={1.5}
              class="mb-5 text-primary"
              aria-hidden="true"
            />
            <h3 class="mb-2 text-base font-medium">{feature.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">
              {feature.description}
            </p>
          </CardContent>
        </Card>
      ))}
    </div>
  </div>
</section>
