---
import { Image } from "astro:assets";
import logo from "../assets/paradiseicon.png";
import { SiteNavigation } from "./site-navigation";
---

<header class="sticky top-0 z-40 border-b bg-background/95 backdrop-blur-md">
  <div class="page-container flex h-20 items-center justify-between gap-4">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5"
      aria-label="Paradise Chapadmalal, inicio"
    >
      <Image
        src={logo}
        alt=""
        width={40}
        height={40}
        class="size-10 object-contain"
      />
      <span class="flex flex-col">
        <span class="text-lg font-semibold tracking-tight">paradise</span>
        <span class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
          Chapadmalal
        </span>
      </span>
    </a>
    <SiteNavigation client:load pathname={Astro.url.pathname} />
  </div>
  <noscript>
    <nav
      aria-label="Navegación"
      class="page-container flex flex-wrap gap-4 pb-4 text-sm"
    >
      <a href="/cabanas">Cabañas</a>
      <a href="/#experiencia">La experiencia</a>
      <a href="/#ubicacion">Ubicación</a>
      <a href="https://wa.link/ob3h9i">Consultar disponibilidad</a>
    </nav>
  </noscript>
</header>
