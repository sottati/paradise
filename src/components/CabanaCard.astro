---
import { Image } from "astro:assets";
import { ArrowUpRight, Users } from "@lucide/astro";
import { Card, CardContent } from "./ui/card";
import { Badge } from "./ui/badge";
import type { Cabana } from "../data/cabanas";
interface Props {
  cabana: Cabana;
  heading?: "h2" | "h3";
}
const { cabana, heading: Heading = "h3" } = Astro.props;
---

<a
  href={`/cabanas/${cabana.slug.current}`}
  class="group block rounded-xl"
  aria-label={`Conocé ${cabana.nombre}, ${cabana.capacidad}`}
>
  <Card className="gap-0 overflow-hidden border-border/80 bg-card py-0 shadow-none transition-colors hover:border-primary/50">
    <div class="relative aspect-[4/3] overflow-hidden">
      <Image
        src={cabana.portada}
        width={900}
        alt={`${cabana.nombre} en Paradise Chapadmalal`}
        class="size-full object-cover"
        widths={[400, 640, 900]}
        sizes="(max-width: 767px) 100vw, 33vw"
        loading="lazy"
      />
      <span class="absolute left-4 top-4">
        <Badge
          variant="secondary"
          className="gap-1.5 bg-background/95 px-3 py-1.5 font-normal"
        >
          <Users size={13} aria-hidden="true" />
          {cabana.capacidad}
        </Badge>
      </span>
    </div>
    <CardContent className="p-5 sm:p-6">
      <p class="eyebrow mb-3">Tu refugio en Chapa</p>
      <div class="flex items-center justify-between gap-3">
        <Heading class="text-2xl font-medium tracking-tight">
          {cabana.nombre}
        </Heading>
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-background group-hover:bg-accent">
          <ArrowUpRight size={19} aria-hidden="true" />
        </span>
      </div>
      <p class="mt-3 text-sm text-muted-foreground">
        Conocé la cabaña y mirá sus fotos
      </p>
    </CardContent>
  </Card>
</a>
