---
import { getImage } from "astro:assets";
import type { Imagen } from "../data/cabanas";
import { CabinGallery } from "./cabin-gallery";
interface Props {
  imagenes: Imagen[];
  nombreCabana: string;
}
const { imagenes, nombreCabana } = Astro.props;
const photos = await Promise.all(
  imagenes.map(async (image, index) => {
    const widths = [400, 800, 1200].filter((width) => width <= image.src.width);
    const optimized = await Promise.all(
      widths.map((width) =>
        getImage({ src: image.src, width, format: "webp" }),
      ),
    );
    const fallback =
      optimized.at(-1) ?? (await getImage({ src: image.src, format: "webp" }));
    return {
      src: fallback.src,
      srcSet: optimized
        .map((result, i) => `${result.src} ${widths[i]}w`)
        .join(", "),
      alt: `${nombreCabana}, foto ${index + 1}`,
      width: image.src.width,
      height: image.src.height,
    };
  }),
);
---

<CabinGallery client:load photos={photos} name={nombreCabana} />
<noscript>
  <div class="mt-4 grid grid-cols-2 gap-3">
    {photos.slice(5).map((photo) => (
      <img
        src={photo.src}
        alt={photo.alt}
        width={photo.width}
        height={photo.height}
        loading="lazy"
        class="aspect-[4/3] size-full rounded-lg object-cover"
      />
    ))}
  </div>
</noscript>
