---
import { getOptimizedImageUrl } from "../lib/imageUrlBuilder";

interface Props {
  imagenes: any[];
  nombreCabana: string;
}

const { imagenes, nombreCabana } = Astro.props;
---

<div class="galeria-cabana">
  {
    imagenes.length === 1 ? (
      <div class="w-full">
        <img
          src={getOptimizedImageUrl(imagenes[0].asset, 1200, 800)}
          alt={imagenes[0].alt || `${nombreCabana} - Imagen 1`}
          class="w-full h-auto rounded-xl shadow-lg"
          loading="eager"
        />
      </div>
    ) : imagenes.length === 2 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {imagenes.map((imagen: any, index: number) => (
          <img
            src={getOptimizedImageUrl(imagen.asset, 600, 400)}
            alt={imagen.alt || `${nombreCabana} - Imagen ${index + 1}`}
            class="w-full h-full object-cover rounded-xl shadow-lg"
            loading={index === 0 ? "eager" : "lazy"}
          />
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {/* Primera imagen grande */}
        <div class="col-span-2 md:col-span-2 row-span-2">
          <img
            src={getOptimizedImageUrl(imagenes[0].asset, 800, 600)}
            alt={imagenes[0].alt || `${nombreCabana} - Imagen principal`}
            class="w-full h-full object-cover rounded-xl shadow-lg"
            loading="eager"
          />
        </div>

        {/* Resto de imágenes */}
        {imagenes.slice(1, 5).map((imagen: any, index: number) => (
          <div class="col-span-1 aspect-square">
            <img
              src={getOptimizedImageUrl(imagen.asset, 400, 400)}
              alt={imagen.alt || `${nombreCabana} - Imagen ${index + 2}`}
              class="w-full h-full object-cover rounded-xl shadow-lg"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )
  }

  <!-- Grid adicional para más imágenes si hay más de 5 -->
  {
    imagenes.length > 5 && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        {imagenes.slice(5).map((imagen: any, index: number) => (
          <div class="aspect-square">
            <img
              src={getOptimizedImageUrl(imagen.asset, 400, 400)}
              alt={imagen.alt || `${nombreCabana} - Imagen ${index + 6}`}
              class="w-full h-full object-cover rounded-xl shadow-lg"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    )
  }
</div>

<style>
  .galeria-cabana {
    width: 100%;
  }

  .galeria-cabana img {
    transition: transform 0.3s ease;
  }

  .galeria-cabana img:hover {
    transform: scale(1.02);
  }
</style>
