---
import { Image } from "astro:assets";
import type { Imagen } from "../data/cabanas";

interface Props {
  imagenes: Imagen[];
  nombreCabana: string;
}

const { imagenes, nombreCabana } = Astro.props;
---

<div class="galeria-cabana">
  {
    imagenes.length === 1 ? (
      <div class="w-full">
        <Image
          src={imagenes[0].src}
          alt={imagenes[0].alt || `${nombreCabana} - Imagen 1`}
          class="w-full h-auto rounded-xl shadow-lg"
          loading="eager"
          widths={[400, 800, 1200]}
          sizes="100vw"
        />
      </div>
    ) : imagenes.length === 2 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {imagenes.map((imagen, index) => (
          <Image
            src={imagen.src}
            alt={imagen.alt || `${nombreCabana} - Imagen ${index + 1}`}
            class="w-full h-full object-cover rounded-xl shadow-lg"
            loading={index === 0 ? "eager" : "lazy"}
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        ))}
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {/* Primera imagen grande */}
        <div class="col-span-2 md:col-span-2 row-span-2">
          <Image
            src={imagenes[0].src}
            alt={imagenes[0].alt || `${nombreCabana} - Imagen principal`}
            class="w-full h-full object-cover rounded-xl shadow-lg"
            loading="eager"
            widths={[400, 600, 800]}
            sizes="(max-width: 768px) 100vw, 50vw"
          />
        </div>

        {/* Resto de imágenes */}
        {imagenes.slice(1, 5).map((imagen, index) => (
          <div class="col-span-1 aspect-square">
            <Image
              src={imagen.src}
              alt={imagen.alt || `${nombreCabana} - Imagen ${index + 2}`}
              class="w-full h-full object-cover rounded-xl shadow-lg"
              loading="lazy"
              widths={[200, 400]}
              sizes="(max-width: 768px) 50vw, 25vw"
            />
          </div>
        ))}
      </div>
    )
  }

  <!-- Grid adicional para más imágenes si hay más de 5 -->
  {
    imagenes.length > 5 && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-4">
        {imagenes.slice(5).map((imagen, index) => (
          <div class="aspect-square">
            <Image
              src={imagen.src}
              alt={imagen.alt || `${nombreCabana} - Imagen ${index + 6}`}
              class="w-full h-full object-cover rounded-xl shadow-lg"
              loading="lazy"
              widths={[200, 400]}
              sizes="(max-width: 768px) 50vw, 25vw"
            />
          </div>
        ))}
      </div>
    )
  }
</div>

<style>
  .galeria-cabana {
    width: 100%;
  }

  .galeria-cabana img {
    transition: transform 0.3s ease;
  }

  .galeria-cabana img:hover {
    transform: scale(1.02);
  }
</style>
