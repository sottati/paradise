---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/hero.astro";
import Features from "../components/features.astro";

import { Image } from "astro:assets";
import fogonero from "../images/casa-paradise/fogonero.png";
import Opiniones from "../components/opiniones.astro";
import Mapa from "../components/Mapa.astro";
import ReelIg from "../components/reel-ig.astro";

const reels = [
  {
    url: "https://www.instagram.com/reel/DDe7CMVR5dP/?igsh=YWFkdGR5bWlhbGo5",
    version: "14",
    containerClass: "flex flex-block justify-center items-center",
  },
  {
    url: "https://www.instagram.com/reel/DFX84JUR3G_/?igsh=MWNjendxdmk5NWltZQ==",
    version: "14",
    containerClass: "flex flex-block justify-center items-center",
  },
  {
    url: "https://www.instagram.com/reel/CzYaTLPrh3e/?igsh=dDg5ZmlyZnlpM29v",
    version: "14",
    containerClass: "flex flex-block justify-center items-center",
  },
];
---

<Layout>
  <Hero />
  <Features />
  <div class="flex flex-row flex-wrap gap-4 justify-around items-center mb-8">
    {
      reels.map((reel) => (
        <ReelIg
          url={reel.url}
          version={reel.version}
          containerClass={reel.containerClass}
        />
      ))
    }
  </div>
  <section
    class="grid grid-cols-1 md:grid-cols-2 items-center justify-center md:p-12 md:gap-4 md:h-screen"
  >
    <div class="h-full w-full overflow-hidden">
      <Image
        src={fogonero}
        alt="Fogonero"
        class="h-full w-full object-cover"
        loading="eager"
        decoding="sync"
      />
    </div>
    <p class="p-8 text-center text-xl md:text-3xl font-light">
      El jardín de uso común con plantas, árboles, parrilla y fogonero, ofrece
      un ambiente rodeado de naturaleza para disfrutar entre los huéspedes.
      Nuestro propósito es brindar un trato cercano, un ambiente relajado y
      familiar.
    </p>
  </section>
  <Opiniones />
  <Mapa />
</Layout>
