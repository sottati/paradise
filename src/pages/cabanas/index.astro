---
import Layout from "../../layouts/Layout.astro";
import CabanaCard from "../../components/CabanaCard.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import { ArrowUpRight } from "@lucide/astro";
import { getCabanas } from "../../data/cabanas";
import { site } from "../../lib/site";
---

<Layout title="Nuestras cabañas | Paradise Chapadmalal">
  <section class="page-container section-space">
    <p class="eyebrow mb-5">Paradise Chapadmalal</p>
    <div class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <h1 class="section-title">
          Tu próxima escapada,
          <br />
          un poco más cerca.
        </h1>
        <p class="section-copy mt-5 max-w-xl">
          Tres cabañas entre el campo y el mar. Elegí con quién venir, nosotros
          te esperamos.
        </p>
      </div>
      <p class="flex items-center gap-2 text-sm text-muted-foreground">
        <span class="size-2 rounded-full bg-primary"></span>Cabañas para 2, 4 y
        6 personas
      </p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {getCabanas().map((cabana) => (
        <CabanaCard cabana={cabana} heading="h2" />
      ))}
    </div>
    <div class="mt-12 flex flex-col justify-between gap-5 rounded-xl border bg-secondary/50 p-6 sm:flex-row sm:items-center sm:p-8">
      <div>
        <h2 class="text-xl font-medium tracking-tight">Te ayudamos a elegir</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Contanos cuántos vienen y en qué fechas querés visitarnos.
        </p>
      </div>
      <ButtonLink
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="self-start sm:shrink-0"
      >
        Consultar disponibilidad
        <ArrowUpRight size={16} aria-hidden="true" />
      </ButtonLink>
    </div>
  </section>
</Layout>
