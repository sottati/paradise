---
import Layout from "../../layouts/Layout.astro";
import { getCabanas } from "../../data/cabanas";
import GaleriaCabana from "../../components/GaleriaCabana.astro";
import CabanaCard from "../../components/CabanaCard.astro";
import ButtonLink from "../../components/ui/ButtonLink.astro";
import { Badge } from "../../components/ui/badge";
import { Card, CardContent } from "../../components/ui/card";
import {
  ArrowLeft,
  ArrowUpRight,
  Users,
  MapPin,
  Wifi,
  Flame,
  Sparkles,
} from "@lucide/astro";
import { site } from "../../lib/site";
export const prerender = true;
export function getStaticPaths() {
  return getCabanas().map((cabana) => ({
    params: { slug: cabana.slug.current },
    props: { cabana },
  }));
}
const { cabana } = Astro.props;
const otherCabins = getCabanas().filter((item) => item._id !== cabana._id);
const galleryImages = [
  { src: cabana.portada, alt: `${cabana.nombre}, exterior` },
  ...cabana.imagenes.filter((image) => image.src.src !== cabana.portada.src),
];
---

<Layout title={`${cabana.nombre}, ${cabana.capacidad} | Paradise Chapadmalal`}>
  <section class="page-container pb-16 pt-8 md:pb-24 md:pt-12">
    <ButtonLink
      href="/cabanas"
      variant="ghost"
      size="sm"
      class="mb-7 -ml-3 text-muted-foreground"
    >
      <ArrowLeft size={16} aria-hidden="true" />
      Todas las cabañas
    </ButtonLink>
    <div class="mb-8 flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow mb-3">Tu refugio en Chapa</p>
        <h1 class="section-title">{cabana.nombre}</h1>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-sm text-muted-foreground">
          <Badge variant="secondary" className="gap-2 px-3 py-1.5 font-normal">
            <Users size={14} aria-hidden="true" />
            {cabana.capacidad}
          </Badge>
          <span class="flex items-center gap-1.5">
            <MapPin size={15} aria-hidden="true" />
            Chapadmalal, Buenos Aires
          </span>
        </div>
      </div>
      <ButtonLink
        href={site.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="self-start sm:self-auto"
      >
        Consultar disponibilidad
        <ArrowUpRight size={16} aria-hidden="true" />
      </ButtonLink>
    </div>
    <GaleriaCabana imagenes={galleryImages} nombreCabana={cabana.nombre} />
    <div class="mt-10 grid items-start gap-8 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
      <div>
        <h2 class="text-2xl font-medium tracking-tight">
          Unos días para disfrutar.
        </h2>
        <p class="section-copy mt-4">
          {cabana.nombre} te espera para una estadía de {cabana.capacidad}, en
          un ambiente relajado y familiar entre el campo y el mar.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Compartí el jardín, una comida en la parrilla o una charla al lado del
          fogonero. El descanso empieza acá.
        </p>
        <div class="mt-7 grid gap-4 border-t pt-6 text-sm sm:grid-cols-2">
          <span class="flex items-center gap-3">
            <Wifi size={19} stroke-width={1.5} aria-hidden="true" />
            Wi-Fi
          </span>
          <span class="flex items-center gap-3">
            <Flame size={19} stroke-width={1.5} aria-hidden="true" />
            Parrilla y fogonero compartidos
          </span>
          <span class="flex items-center gap-3">
            <Sparkles size={19} stroke-width={1.5} aria-hidden="true" />
            Sábanas y kit de cortesía
          </span>
        </div>
      </div>
      <Card className="gap-0 bg-secondary/40 py-0 shadow-none">
        <CardContent className="p-6 sm:p-8">
          <p class="eyebrow mb-3">Planeá tu visita</p>
          <h2 class="text-2xl font-medium tracking-tight">
            Te esperamos en Paradise.
          </h2>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Escribinos con tus fechas y la cantidad de huéspedes para consultar
            disponibilidad.
          </p>
          <ButtonLink
            href={site.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 w-full"
          >
            Hablemos por WhatsApp
            <ArrowUpRight size={16} aria-hidden="true" />
          </ButtonLink>
        </CardContent>
      </Card>
    </div>
    <div class="mt-16 border-t pt-12">
      <p class="eyebrow mb-3">Seguí explorando</p>
      <h2 class="mb-7 text-3xl font-medium tracking-tight">
        También te pueden gustar
      </h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {otherCabins.map((item) => (
          <CabanaCard cabana={item} />
        ))}
      </div>
    </div>
  </section>
</Layout>
