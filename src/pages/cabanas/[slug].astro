---
import Layout from "../../layouts/Layout.astro";
import { getCabanas } from "../../data/cabanas";
import GaleriaCabana from "../../components/GaleriaCabana.astro";

export const prerender = true;

export async function getStaticPaths() {
  const cabanas = getCabanas();

  return cabanas.map((cabana) => ({
    params: { slug: cabana.slug.current },
    props: { cabana },
  }));
}

const { cabana } = Astro.props;
---

<Layout>
  <section class="py-28 md:py-24 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      <!-- Header -->
      <div class="mb-8 flex justify-between items-start">
        <div>
          <h1 class="text-4xl md:text-5xl font-bold text-black mb-4">
            {cabana.nombre}
          </h1>
          <div class="flex items-center gap-2 text-gray-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              viewBox="0 0 20 20"
              fill="currentColor"
            >
              <path
                d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"
              ></path>
            </svg>
            <span class="text-lg font-medium">{cabana.capacidad}</span>
          </div>
        </div>
        <a
          href="https://wa.link/ob3h9i"
          target="_blank"
          class="text-black underline font-semibold md:px-8 py-3 text-end transition-colors duration-200"
        >
          Consultar disponibilidad
        </a>
      </div>

      <!-- Galería -->
      {
        cabana.imagenes && cabana.imagenes.length > 0 && (
          <GaleriaCabana
            imagenes={cabana.imagenes}
            nombreCabana={cabana.nombre}
          />
        )
      }
    </div>
  </section>
</Layout>
